<?xml version="1.0"?>
<package format="3">
    <name>seatrac</name>
    <version>1.0.0</version>
    <description>Communicate with a SeaTrac surface vessel</description>
    <license>TODO</license>

    <url type="repository">https://github.com/whoigit/seatrac-api</url>

    <maintainer email="mbrosnahan@whoi.edu">Michael Brosnahan</maintainer>
    <maintainer email="rgovostes@whoi.edu">Ryan Govostes</maintainer>

    <author email="rgovostes@whoi.edu">Ryan Govostes</author>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>
    <depend>ds_core_msgs</depend>
    <depend>std_msgs</depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>rosidl_default_runtime</exec_depend>
    <exec_depend>wr2_msgs</exec_depend>
    <test_depend>ament_cmake_pytest</test_depend>
    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
